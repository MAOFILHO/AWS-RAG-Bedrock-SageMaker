{
  "version": 1,
  "description": "AWS RAG Bedrock SageMaker build board",
  "project": { "owner": "MAOFILHO", "title": "AWS-RAG-Bedrock-SageMaker board", "number": 5 },
  "worker_backend": "workflow",
  "host": "claude",
  "model_tier": "medium",
  "codex": { "model": null },
  "target": { "type": "repo", "url": null },
  "repo": { "path": ".", "remote": "https://github.com/MAOFILHO/AWS-RAG-Bedrock-SageMaker" },
  "base_branch": "staging",
  "timezone": "America/Toronto",
  "columns": ["Backlog", "Ready", "Building", "QA", "Review", "Blocked", "Done"],
  "labels": ["qa", "bug", "feature"],
  "paths": {
    "project_md": "docs/super-board/PROJECT.md",
    "pre_flight_md": "docs/super-board/pre-flight.md",
    "runs_dir": "docs/super-board/runs"
  },
  "human_approves_merge": false,
  "merge_policy": {
    "default": "auto",
    "auto_max_lines": 1000,
    "size_exclude": [
      "**/package-lock.json", "**/yarn.lock", "**/pnpm-lock.yaml", "**/bun.lockb", "**/bun.lock",
      "**/npm-shrinkwrap.json", "**/Cargo.lock", "**/poetry.lock", "**/uv.lock", "**/Pipfile.lock",
      "**/Gemfile.lock", "**/composer.lock", "**/go.sum", "**/Podfile.lock", "**/pubspec.lock",
      "**/generated/**", "**/__generated__/**", "**/*.generated.*", "**/*.gen.*",
      "**/*.min.js", "**/*.min.css", "**/*.map", "**/*.pb.go", "**/*_pb2.py",
      "**/__snapshots__/**", "**/*.snap"
    ],
    "always_human": {
      "money": { "labels": ["money", "payments", "billing", "pricing"], "paths": ["**/billing/**", "**/payments/**", "**/stripe/**", "**/checkout/**"], "keywords": ["stripe.", "payment_intent", "price_id", "invoice.create"] },
      "auth": { "labels": ["auth", "security"], "paths": ["**/auth/**", "**/authz/**", "**/permissions/**"], "keywords": ["jwt.sign", "bcrypt", "password_hash", "service_role"] },
      "schema": { "labels": ["schema", "destructive"], "paths": [], "keywords": ["drop table", "drop column", "truncate table", "rename column", "drop schema"] }
    },
    "allow_auto_on_production": false
  },
  "migrations": {
    "globs": ["supabase/migrations/**", "prisma/migrations/**", "drizzle/**", "**/migrations/*.sql", "db/migrate/**", "alembic/versions/**"],
    "allowed_envs": ["test", "staging"],
    "target_env": "staging",
    "commands": {},
    "checks": {},
    "human_steps": []
  },
  "verify_commands": [
    "uv sync --frozen && uv run pytest"
  ],
  "collect": {
    "sources": ["github", "prs", "architecture"],
    "window_days": 14,
    "prs": { "max_prs": 200 },
    "architecture": { "max_findings": 5 },
    "custom": []
  },
  "notifications": { "channel": "session", "chat_id": null, "bot_identity": "MAOFILHO" }
}
